{
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "types": ["bun"],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,

    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
